{
	"name": "pcb-tht-holder",
	"version": "1.13.13",
	"type": "module",
	"main": "build/index.js",
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"ts:check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write . | grep -v 'unchanged' | sed G",
		"lint:check": "eslint .",
		"lint:fix": "eslint --fix .",
		"npm:reinstall": "rm -rf ./node_modules && rm -f ./package-lock.json && npm i && npm i",
		"all": "node --run format:fix && node --run lint:fix && node --run ts:check && node --run test && node --run build"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/three": "^0.186.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unicorn": "^64.0.0",
		"postcss": "^8.5.29",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"dayjs": "^1.11.23",
		"flowbite-svelte": "^1.33.1",
		"konva": "^10.7.1",
		"nanoid": "^5.1.7",
		"svelte": "^5.57.2",
		"svelte-konva": "^1.0.1",
		"svelte-persisted-store": "^0.12.0",
		"three": "^0.186.1",
		"three-bvh-csg": "^0.0.18",
		"zod": "^4.6.5"
	}
}
